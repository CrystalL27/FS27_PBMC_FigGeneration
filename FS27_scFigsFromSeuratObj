#Can we show plots separate by treatment group
#create new file to change idents to treatment 
pbmc3 <- FS27PBMC_2
Idents(pbmc3) <- "treatment"
#combined UMAP with treatment as overlay
DimPlot(pbmc3, reduction = "umap", group.by = "treatment", cols = c("darkblue", "191919FF")) +
  ggtitle("Treatment Groups") 

#Separate UMAPS by treatment
DimPlot_scCustom(seurat_object = FS27PBMC_2, 
                 group.by = "celltypes", split.by = "treatment", label = FALSE, 
                 colors_use = DiscretePalette_scCustomize(num_colors = 19, palette = "alphabet"))

